rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write ONLY their own data (profile, current bill, saved bills).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Lets a username find its login email. Anyone can look up ONE username at a time
    // (needed before login), but nobody can list them, change or take over a username.
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list, update: if false;
    }
  }
}
